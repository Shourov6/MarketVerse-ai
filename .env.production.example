# ════════════════════════════════════════════════════════════════
#  PRODUCTION ENVIRONMENT TEMPLATE
#  Copy this to .env on your server and fill in real values.
#  NEVER commit .env to git.
# ════════════════════════════════════════════════════════════════

# ── Node ────────────────────────────────────────────────────────
NODE_ENV=production

# ── Server port (Railway/Render set this automatically) ─────────
PORT=3000

# ── Database (MySQL 8) ───────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:CHANGE_ME@your-mysql-host:3306/ecommerce_db

# ── Security ─────────────────────────────────────────────────────
# REQUIRED: change to a long random string (32+ chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# ── App ID (used in OAuth, can be any string) ───────────────────
APP_ID=my_ecommerce_app

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of your public domain(s). Example:
# CORS_ORIGIN=https://mystore.com,https://www.mystore.com
# For testing with no fixed domain, leave as * (less secure)
CORS_ORIGIN=*

# ── Admin user (first login gets admin role) ────────────────────
# Set this to the phone number or union ID of the first admin user.
# For demo: the admin demo account uses phone 01700000006
OWNER_UNION_ID=local:01700000006

# ── Kimi OAuth (OPTIONAL — only if you want Kimi SSO login) ────
# Leave blank to disable Kimi OAuth (phone/password login still works)
KIMI_AUTH_URL=
KIMI_OPEN_URL=
VITE_KIMI_AUTH_URL=
VITE_APP_ID=
